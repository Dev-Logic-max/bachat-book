# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env*.local` alone does NOT match a bare `.env`, and Expo's convention puts
# the real values there — so on a public repo the plain `.env` is the one that
# leaks. Ignore all of them and keep `.env.example` as the tracked template.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Release signing. The keystore and its passwords must never be committed:
# whoever holds them can publish an update that Android accepts as this app.
credentials/
