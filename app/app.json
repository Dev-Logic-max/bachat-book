{
  "expo": {
    "name": "Bachat Book",
    "slug": "bachat-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bachatbook",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F6F1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bachatbook.app"
    },
    "android": {
      "package": "com.bachatbook.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B1A33"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-release-signing",
      "./plugins/with-build-tuning",
      "./plugins/with-dev-variant",
      [
        "expo-camera",
        {
          "cameraPermission": "Bachat Book uses the camera to photograph a receipt and read its line items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bachat Book needs your photo library to attach a receipt image to an entry."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bachat Book uses Face ID to lock your financial records on a shared phone."
        }
      ]
    ]
  }
}
