# Repo-wide ignores. web/ and app/ each keep their own .gitignore for
# framework-specific output; this file covers what is common to both.

# dependencies
node_modules/
.pnpm-store/

# env — never commit real values. `.env.example` files ARE tracked.
.env
.env.*
!.env.example

# build output
dist/
build/
.next/
out/

# native build folders (regenerated by `expo prebuild`)
android/
ios/

# editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo

# vercel
.vercel

# Design reference images — 37 PNGs, ~197 MB.
#
# Deliberately excluded. They are inputs to the design process, not part of the
# product: nothing builds, runs or tests against them, and the same images live
# in `design-brain/`. Committing them would put 197 MB into every clone of a
# public repo permanently — git history is immutable, so deleting them in a
# later commit does not shrink it.
#
# To include them anyway, delete these two lines BEFORE the first push. Doing it
# afterwards means rewriting history.
references/

# secrets and keys of any kind
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
