# Copy to `app/.env` and fill in. `.env` is gitignored — never commit it.
#
# Both values are the SAME ones the web app uses. Copy them from
# `web/.env.local`, or read them from Supabase → Project Settings → API Keys.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time and are
# readable by anyone who unzips the APK. That is correct for these two — the
# publishable key grants nothing on its own and every table is protected by RLS.
# Never add a variable with this prefix that you would not publish.
#
# The service_role key bypasses every RLS policy. It must never appear here, in
# app.json, or anywhere the app bundle can reach. Server-only secrets belong in
# Supabase Edge Function secrets (`supabase secrets set`).

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
