# Copy to .env.local and fill in. .env* is gitignored.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin used to build auth callback URLs. Must also be registered in
# Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# NEVER add the service_role key with a NEXT_PUBLIC_ prefix — that ships it to
# the browser and bypasses every RLS policy in the database.

# ---------------------------------------------------------------------------
# Development seed account
# ---------------------------------------------------------------------------
# The super_admin the seed script creates, used to sign in during development
# and as the "owner" side of the stranger-vs-owner isolation proof in
# db/README.md.
#
# These used to be written into ROADMAP.md, db/README.md and SESSION-START.md
# in plaintext. The docs now name these variables instead, so the value lives
# in one gitignored place and the repo can be public.
#
# NO `NEXT_PUBLIC_` PREFIX, deliberately. That prefix inlines a value into the
# browser bundle — a password there is readable by every visitor. These are read
# only by seed scripts, the screenshot-loop `--login` flag and manual testing,
# never by a component.
#
# Development only. Never point these at an account that holds real data.
SEED_ADMIN_EMAIL=admin@bachatbook.com
SEED_ADMIN_PASSWORD=
