# Metro cannot follow pnpm's symlinked store — it resolves modules by walking
# real directories, so a symlinked node_modules produces "Unable to resolve
# module" for packages that are plainly installed. Hoisting lays the tree out
# the way npm would while keeping pnpm as the installer.
node-linker=hoisted

# React Native's own peer graph is inconsistent across the Expo SDK; a strict
# peer check fails the install on warnings that do not affect the build.
strict-peer-dependencies=false
